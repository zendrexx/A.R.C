{
  "name": "arc-memory",
  "displayName": "A.R.C. \u2014 Project Memory",
  "description": "Local evidence, tasks and continuity in your editor.",
  "version": "0.1.0",
  "publisher": "arc-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/zendrexx/A.R.C.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test tests/backend.test.cjs tests/extension.test.cjs tests/ollama.test.cjs tests/controls.test.cjs tests/dashboard.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc",
          "title": "A.R.C.",
          "icon": "media/arc.svg"
        }
      ]
    },
    "views": {
      "arc": [
        {
          "id": "arc.actions",
          "name": "A.R.C. Quick Actions"
        },
        {
          "id": "arc.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "arc.memory",
          "name": "Memory"
        }
      ]
    },
    "commands": [
      {
        "command": "arc.createProject",
        "title": "ARC: Register Project"
      },
      {
        "command": "arc.connect",
        "title": "ARC: Connect Project"
      },
      {
        "command": "arc.setupLocalAI",
        "title": "ARC: Retry Local AI Setup"
      },
      {
        "command": "arc.create",
        "title": "ARC: Create Project"
      },
      {
        "command": "arc.delete",
        "title": "ARC: Delete Project Memory"
      },
      {
        "command": "arc.refresh",
        "title": "ARC: Refresh Memory",
        "icon": "$(refresh)"
      },
      {
        "command": "arc.search",
        "title": "ARC: Search Memory",
        "icon": "$(search)"
      },
      {
        "command": "arc.capture",
        "title": "ARC: Capture Changes"
      },
      {
        "command": "arc.checkpoint",
        "title": "ARC: Create Candidate Checkpoint"
      },
      {
        "command": "arc.index",
        "title": "ARC: Index Memories"
      },
      {
        "command": "arc.disconnect",
        "title": "ARC: Disconnect Project"
      },
      {
        "command": "arc.observe",
        "title": "ARC: Enable Automatic Observation"
      },
      {
        "command": "arc.pause",
        "title": "ARC: Pause Automatic Tracking"
      },
      {
        "command": "arc.resume",
        "title": "ARC: Resume Automatic Tracking"
      },
      {
        "command": "arc.disable",
        "title": "ARC: Disable Observation"
      },
      {
        "command": "arc.timeline",
        "title": "ARC: Show Timeline"
      },
      {
        "command": "arc.test",
        "title": "ARC: Run Configured Test"
      },
      {
        "command": "arc.dashboard",
        "title": "ARC: Open Dashboard"
      },
      {
        "command": "arc.sidebar",
        "title": "ARC: Open Sidebar"
      },
      {
        "command": "arc.openChat",
        "title": "ARC: Open AI Chat"
      },
      {
        "command": "arc.quickActions",
        "title": "ARC: Quick Actions"
      },
      {
        "command": "arc.startOllama",
        "title": "ARC: Start Ollama"
      },
      {
        "command": "arc.selectChatModel",
        "title": "ARC: Select AI Model"
      },
      {
        "command": "arc.selectEmbeddingModel",
        "title": "ARC: Select Embedding Model"
      },
      {
        "command": "arc.modelStatus",
        "title": "ARC: Show Model Status"
      },
      {
        "command": "arc.installedModels",
        "title": "ARC: View Installed Models"
      },
      {
        "command": "arc.loadModel",
        "title": "ARC: Load Selected Model"
      },
      {
        "command": "arc.unloadModel",
        "title": "ARC: Unload Selected Model"
      },
      {
        "command": "arc.retryModel",
        "title": "ARC: Retry Model Operation"
      },
      {
        "command": "arc.downloadModel",
        "title": "ARC: Download Model"
      },
      {
        "command": "arc.modelActions",
        "title": "ARC: AI Model Controls"
      },
      {
        "command": "arc.modelSettings",
        "title": "ARC: Open Model Settings"
      },
      {
        "command": "arc.state",
        "title": "ARC: Show Project State"
      },
      {
        "command": "arc.handoff",
        "title": "ARC: Show Handoff"
      },
      {
        "command": "arc.sessionStart",
        "title": "ARC: Start Session"
      },
      {
        "command": "arc.sessionEnd",
        "title": "ARC: End Session"
      },
      {
        "command": "arc.unfinished",
        "title": "ARC: Review Unfinished Tasks"
      },
      {
        "command": "arc.settings",
        "title": "ARC: Open Settings"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "arc.refresh",
          "when": "view == arc.memory",
          "group": "navigation"
        },
        {
          "command": "arc.search",
          "when": "view == arc.memory",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arc.memory",
        "contents": "Keep your project context close.\n[Connect a project](command:arc.connect)\n[Create a project](command:arc.create)\nSelect a trusted local workspace to inspect recorded evidence."
      }
    ],
    "configuration": {
      "title": "A.R.C.",
      "properties": {
        "arc.ollama.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start installed Ollama in the background when connecting an approved local project. Existing servers are reused and never terminated.",
          "scope": "machine"
        },
        "arc.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable with arc-memory installed. Empty uses the project's .venv, then python3 (macOS/Linux) or python (Windows).",
          "scope": "machine"
        },
        "arc.databasePath": {
          "type": "string",
          "default": "",
          "description": "Absolute SQLite path shared with CLI/MCP. Empty uses ARC_DB or the backend's default database.",
          "scope": "machine"
        },
        "arc.dashboard.url": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Local URL and port of the existing A.R.C. dashboard.",
          "scope": "machine"
        },
        "arc.models.embedding": {
          "type": "string",
          "default": "all-minilm",
          "description": "Selected installed Ollama embedding model.",
          "scope": "machine"
        },
        "arc.models.chat": {
          "type": "string",
          "default": "",
          "description": "Selected installed conversational Ollama model. Use Select AI Model to choose; empty uses evidence-only chat.",
          "scope": "machine"
        }
      }
    }
  }
}
